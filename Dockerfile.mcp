FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PMOMAX_MCP_HOST=0.0.0.0 \
    PMOMAX_MCP_PORT=8081

WORKDIR /app

RUN groupadd --system --gid 10001 pmomax \
    && useradd --system --uid 10001 --gid pmomax --no-create-home pmomax

COPY requirements-mcp.lock ./
RUN pip install --no-cache-dir --requirement requirements-mcp.lock

COPY pyproject.toml ./
COPY pmomax_mcp ./pmomax_mcp

USER 10001:10001
EXPOSE 8081

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8081/healthz', timeout=3)"

CMD ["python", "-m", "pmomax_mcp.server", "--transport", "streamable-http"]
